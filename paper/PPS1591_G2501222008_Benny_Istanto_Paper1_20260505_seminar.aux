\newlabel{sec:extremes}{{3.4}{8}{Extreme Event Detection}{subsection.3.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces WMO multi-threshold verification at BMKG station locations: (a) Probability of Detection (POD), (b) Critical Success Index (CSI), and (c) Equitable Threat Score (ETS) as functions of precipitation threshold for LS (blue), LSEQM (orange), and LSEQM+DL (green). Lines show the station median; shading shows the interquartile range. Thresholds: 1~mm (measurable), 5~mm (light), 10~mm (moderate), 20~mm (moderate-heavy), 50~mm (heavy), 100~mm (very heavy), 150~mm (extreme).}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:threshold}{{4}{8}{WMO multi-threshold verification at BMKG station locations: (a) Probability of Detection (POD), (b) Critical Success Index (CSI), and (c) Equitable Threat Score (ETS) as functions of precipitation threshold for LS (blue), LSEQM (orange), and LSEQM+DL (green). Lines show the station median; shading shows the interquartile range. Thresholds: 1~mm (measurable), 5~mm (light), 10~mm (moderate), 20~mm (moderate-heavy), 50~mm (heavy), 100~mm (very heavy), 150~mm (extreme)}{figure.caption.6}{}}
