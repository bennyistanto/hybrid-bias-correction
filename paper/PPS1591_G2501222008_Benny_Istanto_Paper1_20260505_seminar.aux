\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Taylor diagrams comparing daily precipitation performance against independent BMKG station observations, stratified by (a) wet season (October--March) and (b) dry season (April--September). Products: CPC-UNI (brown pentagon), IMERG-L (blue circle), IMERG-F (cyan diamond), LS (green triangle), LSEQM (orange square), LSEQM+DL (red star). Large markers show the per-station median; small translucent markers show individual stations. Angular position: Pearson correlation; radial distance: normalized standard deviation; gray arcs: centered RMSE \cite  {ref35}.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:taylor}{{2}{6}{Taylor diagrams comparing daily precipitation performance against independent BMKG station observations, stratified by (a) wet season (October--March) and (b) dry season (April--September). Products: CPC-UNI (brown pentagon), IMERG-L (blue circle), IMERG-F (cyan diamond), LS (green triangle), LSEQM (orange square), LSEQM+DL (red star). Large markers show the per-station median; small translucent markers show individual stations. Angular position: Pearson correlation; radial distance: normalized standard deviation; gray arcs: centered RMSE \cite {ref35}}{figure.caption.3}{}}
