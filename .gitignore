# =============================================================================
# Hybrid Bias Correction - .gitignore
# =============================================================================
# What ships in the public repo:
#   src/, notebooks/, docs/, config*.yml, README, LICENSE, CITATION, deps,
#   CLAUDE.md, .github/, data/example_bali/ (inputs only),
#   data/mask/aoi/bali_subset.nc
#
# What stays local or lives on Zenodo:
#   Indonesia operational input + output  -> Zenodo 20287847
#   Indonesia boundary shapefiles         -> Zenodo (TBD) or fetch script
#   Manuscript drafts                     -> local
#   Colab mirror, scripts, temp           -> local working files only
# =============================================================================

# ---------------------------------------------------------------------------
# Working / private folders (kept local, never committed)
# ---------------------------------------------------------------------------
colab/
paper/
scripts/
temp/
zenodo_supplement/
window_diagnostics.zip
HANDOFF.md
docs/_legacy/

# Internal development notebook: aggregates paper figures + tables.
# Kept private because its outputs are the thesis/MDPI figures, which
# live in their own deposit (see paper/ tree). Figure scripts that
# users actually need are standalone in paper/thesis/scripts/.
notebooks/07_paper_results.ipynb

# ---------------------------------------------------------------------------
# Build artefacts (auto-generated, never committed)
# ---------------------------------------------------------------------------
_site/
docs/.quarto/
docs/_freeze/
docs/objects.json
docs/_inv/
docs/_build/
_build/

# ---------------------------------------------------------------------------
# Data (committed: only the small Bali example bundle + folder READMEs)
# ---------------------------------------------------------------------------
# Indonesia operational input + output -> Zenodo 20287847
# Use dir/* (not dir/) so the placeholder README.md exception below works.
data/input/*
data/output/*
data/downloads/*

# Indonesia full mask + global masks -> not needed for Bali example
data/mask/iso3/*
data/mask/world/*

# Boundary subsets (Indonesia adm levels + global) -> too large for Git
data/subset/adm0/*
data/subset/adm1/*
data/subset/bnd/*
data/subset/iso3/*
data/subset/world/*

# Bali run outputs are regenerable -> users run the notebooks
data/example_bali/output/*

# Always allow the placeholder READMEs so empty data dirs are documented in fresh clones
!data/input/README.md
!data/output/README.md
!data/downloads/README.md
!data/mask/world/README.md
!data/subset/adm0/README.md
!data/subset/adm1/README.md
!data/subset/bnd/README.md
!data/subset/world/README.md
!data/example_bali/output/README.md

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
env/
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
src/*/_version.py

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Coverage / tests
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# Translations
*.mo
*.pot

# Logs / DBs
*.log
*.db
*.rdb

# Mypy cache
.mypy_cache/

# Jupyter
.ipynb_checkpoints/
.virtual_documents/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
.spyproject/
.DS_Store
*.swp
*.swo

# ---------------------------------------------------------------------------
# Secrets / env
# ---------------------------------------------------------------------------
.env

# ---------------------------------------------------------------------------
# Claude Code session state (not the rules file)
# ---------------------------------------------------------------------------
.claude/
CLAUDE.md
HANDOFF*
